# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 gitignore 되어 있습니다.
#   cp .env.example .env

# 명함 서버(dvision-namecard-server, Spring) 주소와 공유 키. 키는 서버의 NAMECARD_INTERNAL_KEY 와 같은 값입니다.
# 직원 · 회사 · 조직 데이터는 전부 이 서버를 거칩니다. (README > 구성)
NAMECARD_API_URL="http://localhost:8090"
NAMECARD_API_KEY=""

# 세션 쿠키(JWT) 서명 키 — 최소 32바이트. 생성: openssl rand -base64 32
# 값을 바꾸면 발급된 세션이 전부 무효화됩니다.
SESSION_SECRET=""

# 로그인 비밀번호는 환경변수가 아닙니다. 직원마다 계정을 갖고, 관리자가 임직원
# 관리에서 비밀번호를 발급합니다. 첫 관리자만 화면이 없으니 스크립트로 만듭니다:
#   pnpm admin:password <이메일>

# 사내 통합 로그인(SSO). 비워 두면 SSO 버튼이 동작하지 않습니다.
OIDC_ISSUER=""
OIDC_CLIENT_ID="dding-dong"
OIDC_CLIENT_SECRET=""

# 서명 HTML / vCard 안에 들어갈 절대 URL 의 베이스. 배포 시 실제 도메인으로 교체.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
